# Apps Script Web App deployment URL — the whole Sheet API surface.
# Read server-side only, by netlify/functions/history.ts. Never referenced from src/.
SHEET_API_URL=

# Shared secret, so a leaked deployment URL alone cannot read or append history.
# NOTE: an Apps Script Web App cannot see request headers — the script only gets
# e.parameter and e.postData. So this travels in the query string (GET) or the
# JSON body (POST), never as an Authorization header.
SHEET_API_TOKEN=
